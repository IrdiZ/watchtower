# Copy to .env and fill in OPENAI_API_KEY. Never commit .env. Key values go to Patterno at hand-in, not via Git.
OPENAI_API_KEY=

# Models (checked against developers.openai.com/api/docs/models on 20 Nov 2026).
# Strong: writes and repairs specs (a few calls per portal). Cheap: page classification.
MODEL_STRONG=gpt-6.2-sol
MODEL_CHEAP=gpt-6-luna
# Blind verification must read pages accurately: one step up from the cheapest model.
MODEL_VERIFY=gpt-6.1-terra

# Reasoning effort per tier (keeps cost and latency down). Valid values depend on the model.
MODEL_REASONING_STRONG=low
MODEL_REASONING_CHEAP=none
MODEL_REASONING_VERIFY=none

# Prices in USD per 1M tokens, for the cost ledger (from the OpenAI models page; re-check before reporting).
PRICE_IN_GPT_6_2_SOL=2.00
PRICE_OUT_GPT_6_2_SOL=10.00
PRICE_IN_GPT_6_1_TERRA=1.00
PRICE_OUT_GPT_6_1_TERRA=5.00
PRICE_IN_GPT_6_LUNA=0.10
PRICE_OUT_GPT_6_LUNA=0.50

LLM_CONCURRENCY=4
MODEL_MAX_CALLS_PER_JOB=20
# 1 = serve listings the portal caps (partial, labelled). Ask Patterno before turning this on.
WATCHTOWER_SERVE_CAPPED=0
WATCHTOWER_REFRESH_INTERVAL=900
WATCHTOWER_MIN_REQUEST_INTERVAL=1.05
